# Variaveis usadas pelos workflows n8n
# Preencha estes valores no ambiente onde o n8n roda.

# Obrigatorio para permitir que os workflows leiam $env.*
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

APIFY_TOKEN=seu-token-apify
OPENAI_API_KEY=sua-chave-openai
CAL_API_KEY=sua-chave-cal-com
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key
EVOLUTION_API_KEY=sua-chave-evolution-api
