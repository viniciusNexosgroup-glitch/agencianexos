{"nodes":[{"parameters":{"rule":{"interval":[{"field":"cronExpression","expression":"17 9,10,11,14,15,16 * * 1-5"}]}},"id":"cron-1","name":"Cron — Horário Comercial","type":"n8n-nodes-base.scheduleTrigger","typeVersion":1.1,"position":[-48,-192]},{"parameters":{"url":"https://fidyajgmzyfmthygseuy.supabase.co/rest/v1/leads_outbound","sendQuery":true,"queryParameters":{"parameters":[{"name":"status","value":"eq.new"},{"name":"order","value":"created_at.asc"},{"name":"limit","value":"2"},{"name":"select","value":"id,business_name,category,city,state,phone,website,google_rating,google_reviews_count,pain_signals"}]},"sendHeaders":true,"headerParameters":{"parameters":[{"name":"apikey","value":"={{ $env.SUPABASE_SERVICE_ROLE_KEY }}"},{"name":"Authorization","value":"={{ 'Bearer ' + $env.SUPABASE_SERVICE_ROLE_KEY }}"}]},"options":{}},"id":"fetch-leads-1","name":"Supabase — Busca Leads Novos","type":"n8n-nodes-base.httpRequest","typeVersion":4.1,"position":[192,-192]},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":1},"conditions":[{"id":"cond-1","leftValue":"={{ $json.length ?? 0 }}","rightValue":0,"operator":{"type":"number","operation":"gt"}}],"combinator":"and"},"options":{}},"id":"if-has-leads-1","name":"Tem leads?","type":"n8n-nodes-base.if","typeVersion":2,"position":[432,-192]},{"parameters":{},"id":"noop-stop-1","name":"Sem leads — Para","type":"n8n-nodes-base.noOp","typeVersion":1,"position":[672,16]},{"parameters":{"jsCode":"const raw = $input.all()[0].json;\nconst leads = Array.isArray(raw) ? raw : [raw];\nreturn leads.map(l => ({ json: l }));"},"id":"split-leads-1","name":"Divide em itens","type":"n8n-nodes-base.code","typeVersion":2,"position":[672,-340]},{"parameters":{"options":{}},"id":"loop-1","name":"Loop 1 lead por vez","type":"n8n-nodes-base.splitInBatches","typeVersion":3,"position":[912,-340]},{"parameters":{"method":"POST","url":"https://api.groq.com/openai/v1/chat/completions","sendHeaders":true,"headerParameters":{"parameters":[{"name":"Authorization","value":"={{ 'Bearer ' + $env.GROQ_API_KEY }}"},{"name":"Content-Type","value":"application/json"}]},"sendBody":true,"specifyBody":"json","jsonBody":"={\n  \"model\": \"llama-3.3-70b-versatile\",\n  \"max_tokens\": 300,\n  \"temperature\": 0.85,\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"Voce e especialista em captacao digital juridica da Nexos Group. Sua tarefa: gerar UMA mensagem de prospeccao via WhatsApp para escritorio de advocacia.\\n\\nPOSICIONAMENTO:\\nA Nexos e mais ampla do que midia paga isolada. Criamos um ecossistema de captacao digital com posicionamento, funis, automacoes, orientacoes/scripts de videos, edicao de videos e midia paga quando fizer sentido.\\n\\nREGRAS ABSOLUTAS:\\n1. NUNCA comece com Ola, Oi, Tudo bem, Bom dia isolado ou qualquer cumprimento generico\\n2. Comece com algo ESPECIFICO do escritorio (nota Google, avaliacoes, cidade, site ou categoria)\\n3. Maximo 4 linhas curtas - sem blocos de texto longos\\n4. Tom casual brasileiro, direto, sem formalismo\\n5. NAO mencione precos\\n6. Termine com UMA pergunta aberta\\n7. SEMPRE inclua no final, em linha separada: (se nao fizer sentido conversar, so dizer que paro de chamar)\\n8. NAO mencione Nexos Group pelo nome na primeira prospeccao\\n9. Use variacoes naturais - nunca copy-paste de template\\n10. NAO reduza a oferta a midia paga isolada\\n\\nEXEMPLO BOM:\\nVi que o escritorio tem 4.7 com 87 avaliacoes em Sao Paulo - isso ja passa confianca pra quem pesquisa advogado.\\nO ponto e transformar essa autoridade em conversas qualificadas de forma mais previsivel.\\nA gente estrutura captacao digital com posicionamento, funis, automacoes, videos e midia quando faz sentido.\\nHoje voces tem algum processo digital pra gerar oportunidades ou ainda depende mais de indicacao?\\n(se nao fizer sentido conversar, so dizer que paro de chamar)\\n\\nRetorne APENAS a mensagem, sem aspas, sem explicacoes.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Escritorio: {{ $json.business_name }}\\nCidade: {{ $json.city }}/{{ $json.state }}\\nNota Google: {{ $json.google_rating ?? 'nao informado' }} ({{ $json.google_reviews_count ?? 0 }} avaliacoes)\\nTem site: {{ $json.website ? 'sim' : 'nao' }}\\nSinais de dor: {{ $json.pain_signals }}\"\n    }\n  ]\n}","options":{}},"id":"groq-gen-1","name":"Groq — Gera Mensagem","type":"n8n-nodes-base.httpRequest","typeVersion":4.1,"position":[1152,-340]},{"parameters":{"jsCode":"const groqResponse = $input.first().json;\nconst mensagem = groqResponse?.choices?.[0]?.message?.content ?? '';\nconst lead = $('Loop 1 lead por vez').item.json;\n\nif (!mensagem) throw new Error('Groq não retornou mensagem: ' + JSON.stringify(groqResponse).slice(0, 200));\n\nreturn [{\n  json: {\n    lead_id:       lead.id,\n    phone:         lead.phone,\n    business_name: lead.business_name,\n    first_message: mensagem.trim().replace(/^[\"']|[\"']$/g, ''),\n  }\n}];"},"id":"extract-msg-1","name":"Extrai mensagem gerada","type":"n8n-nodes-base.code","typeVersion":2,"position":[1392,-340]},{"parameters":{"method":"PATCH","url":"=https://fidyajgmzyfmthygseuy.supabase.co/rest/v1/leads_outbound?id=eq.{{ $json.lead_id }}","sendHeaders":true,"headerParameters":{"parameters":[{"name":"apikey","value":"={{ $env.SUPABASE_SERVICE_ROLE_KEY }}"},{"name":"Authorization","value":"={{ 'Bearer ' + $env.SUPABASE_SERVICE_ROLE_KEY }}"},{"name":"Content-Type","value":"application/json"},{"name":"Prefer","value":"return=minimal"}]},"sendBody":true,"specifyBody":"json","jsonBody":"={\n  \"status\": \"message_generated\",\n  \"first_message\": {{ JSON.stringify($json.first_message) }},\n  \"message_generated_at\": \"{{ new Date().toISOString() }}\"\n}","options":{}},"id":"save-msg-1","name":"Supabase — Salva Mensagem","type":"n8n-nodes-base.httpRequest","typeVersion":4.1,"position":[1632,-340]},{"parameters":{"jsCode":"// Gera delays aleatórios para humanizar o envio\nconst waitSeconds  = Math.floor(Math.random() * 91) + 90;  // 90-180s entre leads\nconst typingSeconds = Math.floor(Math.random() * 4) + 5;   // 5-8s digitando\nconst lead = $('Extrai mensagem gerada').item.json;\n\nreturn [{\n  json: {\n    wait_seconds:   waitSeconds,\n    typing_seconds: typingSeconds,\n    typing_ms:      typingSeconds * 1000,\n    lead_id:        lead.lead_id,\n    phone:          lead.phone,\n    first_message:  lead.first_message,\n    business_name:  lead.business_name,\n  }\n}];"},"id":"calc-delay-1","name":"Calcula Delay Aleatorio","type":"n8n-nodes-base.code","typeVersion":2,"position":[1872,-340]},{"parameters":{"amount":"={{ $json.wait_seconds }}","unit":"seconds"},"id":"wait-random-1","name":"Aguarda Delay Aleatorio","type":"n8n-nodes-base.wait","typeVersion":1.1,"position":[2112,-340],"webhookId":"wait-random-send-hook"},{"parameters":{"method":"POST","url":"https://evolutionapi.viniciusguilherme.shop/chat/sendPresence/vamo","sendHeaders":true,"headerParameters":{"parameters":[{"name":"apikey","value":"={{ $env.EVOLUTION_API_KEY }}"},{"name":"Content-Type","value":"application/json"}]},"sendBody":true,"specifyBody":"json","jsonBody":"={\n  \"number\": \"{{ $('Calcula Delay Aleatorio').item.json.phone }}@s.whatsapp.net\",\n  \"delay\": {{ $('Calcula Delay Aleatorio').item.json.typing_ms }},\n  \"presence\": \"composing\"\n}","options":{"response":{"response":{"fullResponse":true,"neverError":true}}}},"id":"send-presence-1","name":"Envia Digitando","type":"n8n-nodes-base.httpRequest","typeVersion":4.1,"position":[2352,-340]},{"parameters":{"amount":"={{ $('Calcula Delay Aleatorio').item.json.typing_seconds }}","unit":"seconds"},"id":"wait-typing-outbound-1","name":"Aguarda Digitacao","type":"n8n-nodes-base.wait","typeVersion":1.1,"position":[2592,-340],"webhookId":"wait-typing-outbound-hook"},{"parameters":{"method":"POST","url":"https://evolutionapi.viniciusguilherme.shop/message/sendText/vamo","sendHeaders":true,"headerParamet